{
	"extends": "@elyspio/vite-eslint-config/tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"downlevelIteration": null,
		"paths": {
			"@/*": ["./src/*"],
			"@data/*": ["./src/core/data/*"],
			"@components/*": ["./src/view/components/*"],
			"@hooks/*": ["./src/view/hooks/*"]
		},
		"types": ["vite/client"]
	},
	"include": ["src", "vite.config.ts"]
}
