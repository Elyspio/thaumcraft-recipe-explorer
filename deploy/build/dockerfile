# Building front
FROM node:24 AS builder-front

WORKDIR /front

COPY front/package.json front/pnpm-lock.yaml front/pnpm-workspace.yaml /front/
RUN corepack enable && pnpm install --frozen-lockfile --ignore-scripts

COPY front /front/
# Version affichée dans l'application = tag Docker injecté par l'outil de déploiement.
ARG APP_VERSION=dev
ENV VITE_APP_VERSION=$APP_VERSION
RUN pnpm build


# Running — serve the static build with nginx on port 8080.
# nginx-unprivileged listens on 8080 by default and runs as a non-root user.
FROM nginxinc/nginx-unprivileged:alpine AS production
COPY --from=builder-front /front/dist /usr/share/nginx/html
EXPOSE 8080
